{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "allowlister hook claude-code",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "allowlister hook claude-code",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Read|Edit|Write|Glob|Grep|WebFetch|WebSearch|NotebookEdit|mcp__.*"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/session-setup.sh\"",
            "timeout": 180,
            "type": "command"
          }
        ],
        "matcher": "startup|resume"
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(just bootstrap)",
      "Bash(just check)",
      "Bash(just format)",
      "Bash(just format-check)",
      "Bash(just lint)",
      "Bash(just validate)",
      "Bash(just check-versions)",
      "Bash(just test)",
      "Bash(just skilltest)",
      "Bash(just baseline)",
      "Bash(just nx)",
      "Bash(just lint-llm:*)",
      "Bash(just lint-llm-diff:*)",
      "Bash(just lint-llm-validate:*)",
      "Bash(just setup-llmlint)",
      "Bash(just session-setup)",
      "Bash(just upgrade)",
      "Bash(llmlint:*)",
      "Bash(oneharness list)",
      "Bash(./scripts/setup-llmlint.sh)",
      "Bash(./scripts/session-setup.sh)",
      "Bash(uv tool install:*)",
      "Bash(git merge-base:*)",
      "Bash(./scripts/validate-skills.sh:*)",
      "Bash(uv run:*)",
      "Bash(uv sync:*)",
      "Bash(uv lock:*)",
      "Bash(bun install:*)",
      "Bash(bun update:*)",
      "Bash(bunx nx:*)",
      "Bash(asdf install:*)",
      "Bash(asdf plugin add:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr status)",
      "Bash(gh pr checks:*)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf /*)"
    ]
  }
}
