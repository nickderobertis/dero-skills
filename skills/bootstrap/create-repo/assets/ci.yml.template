# Prove the artifact from a clean checkout: bootstrap, then the full gate.
#
# CI must reproduce what a future maintainer or user hits on a fresh machine —
# not a developer's warm local environment. Keep this as the single required
# gate: `just bootstrap` (clean install) then `just check` (format, lint, type
# check, unit, and e2e). See references/ci.md.
#
# Fill in the TODOs: drop the OS matrix to one runner unless the artifact is
# genuinely cross-platform (CLIs, plugins, binaries), and install only the
# toolchain `just bootstrap` needs (e.g. uv / Node / Rust).

name: ci

on:
  push:
    branches: [main]
  pull_request:

# Cancel superseded runs on the same ref to save CI minutes.
concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

# Least privilege: default the GITHUB_TOKEN to read-only and widen per-job only
# where a job genuinely needs more (e.g. a release job adding `contents: write`,
# the pr-title job's `pull-requests: read`). See references/ci.md.
permissions:
  contents: read

jobs:
  check:
    runs-on: ${{ matrix.os }}
    strategy:
      fail-fast: false
      matrix:
        # TODO: collapse to `[ubuntu-latest]` unless the artifact ships
        # cross-platform; test the versions you actually support.
        os: [ubuntu-latest]
    steps:
      - uses: actions/checkout@v4

      - name: Install just
        uses: extractions/setup-just@v2

      # TODO: install the toolchain `just bootstrap` needs, e.g.
      #   - uses: astral-sh/setup-uv@v5        # Python (uv)
      #   - uses: oven-sh/setup-bun@v2         # JavaScript/TypeScript (bun)
      #   - uses: dtolnay/rust-toolchain@stable  # Rust

      - name: Bootstrap
        run: just bootstrap

      - name: Check
        run: just check

  # LLM-judge tier (llmlint) — a blocking PR check, SEPARATE from the `check`
  # gate. It is non-deterministic and needs an authenticated harness, so it never
  # runs inside `just check`. Scoped to the files this PR changed (the merge-base
  # diff with main) so a PR pays for its own changes, not a full-repo sweep.
  # It REQUIRES the harness credential and fails fast without it — it never
  # no-ops to green, which would report unlinted files as clean. Handle fork PRs
  # at the repo level, not here: Settings → Actions → General → Fork pull request
  # workflows → Require approval for all (or first-time) contributors, so a
  # maintainer approves before fork CI runs (secrets stay restricted on
  # pull_request from forks). This `llmlint` context MUST be a required status
  # check in branch protection (setup_github_governance.py enforces it) — else
  # auto-merge lands a PR past a red llmlint run. See references/llmlint.md and
  # references/ci.md.
  llmlint:
    if: github.event_name == 'pull_request' && github.event.action != 'edited'
    runs-on: ubuntu-latest
    steps:
      # Check out the PR head (not the synthetic merge ref) with full history so
      # the merge-base with main resolves.
      - uses: actions/checkout@v4
        with:
          ref: ${{ github.event.pull_request.head.sha }}
          fetch-depth: 0
      - name: Fetch main (diff base)
        run: git fetch --no-tags --depth=2147483647 origin main
      - uses: extractions/setup-just@v2

      - name: Install oneharness + llmlint
        run: |
          ./scripts/setup-llmlint.sh
          echo "$HOME/.local/bin" >> "$GITHUB_PATH"

      # Deterministic, model-free gate first: validate the config structure, that
      # every `llmlint: ignore` directive names a real rule, and that any edited
      # versioned fragment bumped its `version:`. No harness credential needed, so
      # it runs before the paid model tier and fails fast on a config/version-bump
      # slip. Scoped to the branch's changes vs main.
      - name: Validate llmlint config (no model)
        run: just lint-llm-validate --diff-base origin/main

      # TODO: install + authenticate the coding harness oneharness drives (e.g.
      # Claude Code), exporting its credential from secrets, then run the tier
      # over only the changed files.
      - name: Lint changed files
        env:
          # TODO: your harness's credential secret (e.g. ANTHROPIC_API_KEY for
          # Claude Code, OPENAI_API_KEY for Codex).
          HARNESS_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
        run: |
          # Fail with a clear, actionable message instead of an opaque harness
          # error (or a misleading green pass) when the credential is missing.
          if [ -z "${HARNESS_KEY:-}" ]; then
            echo "::error::llmlint needs a harness credential. Add its repo secret" \
                 "(Settings → Secrets and variables → Actions). Fork PRs are gated by" \
                 "the require-approval-for-fork-workflows setting; see references/ci.md." >&2
            exit 1
          fi
          just lint-llm-diff origin/main

  # Prove the end-user install path on the real platform matrix. Enable this
  # when the repo ships something users install (CLI, binary, package, plugin).
  # It is deliberately separate from `check`: `just bootstrap` sets up the *dev*
  # toolchain, this installs the artifact the way a user actually would. See
  # references/ci.md.
  #
  # install:
  #   needs: check
  #   runs-on: ${{ matrix.os }}
  #   strategy:
  #     fail-fast: false
  #     matrix:
  #       os: [ubuntu-latest, macos-latest, windows-latest]
  #   steps:
  #     - uses: actions/checkout@v4
  #     # TODO: build (or download) the artifact the release will ship — wheel,
  #     # binary, tarball — then install it with the SAME command your README
  #     # tells users to run, so docs and CI never drift. Prefer one
  #     # cross-platform command:
  #     #   uvx --from ./dist/<pkg>.whl <tool>   | pipx install ./dist/<pkg>.whl
  #     #   npm i -g ./<pkg>.tgz                 | cargo install --path .
  #     - name: Install (recommended end-user method)
  #       run: echo "TODO: run the documented install command"
  #     - name: Smoke-test the installed entry point
  #       run: <tool> --version

  # Lint the PR title as a required check. Under squash-merge the PR title
  # becomes the one commit that lands and that the release pipeline reads, so a
  # malformed title must not merge. Enable this when you adopt the
  # Conventional-Commits release flow (see references/releasing.md), and add the
  # job name to the required checks in branch protection.
