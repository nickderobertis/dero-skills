# Canonical command surface for this repo.
#
# Keep this list small and memorable. `just bootstrap` must work from a clean
# clone; `just check` is the full quality gate (it must fail on any issue, with
# no warnings-only mode). Replace the placeholder bodies with the real,
# stack-specific commands — see references/composing.md for the catalog, then
# the matching references/languages/<lang>.md and references/shapes/<shape>.md
# for per-stack tools. In a monorepo, each recipe delegates to the orchestrator
# (e.g. `nx affected` / `nx run-many`) instead of looping over packages by hand
# — see references/monorepo.md.

# List available recipes.
default:
    @just --list

# Set up the project from a clean clone: install the toolchain and dependencies.
bootstrap:
    @echo "TODO: install toolchain + dependencies (e.g. uv sync / pnpm install)"

# Full quality gate: format check, lint, type check, and tests (incl. e2e).
# Fail on any issue. e2e is part of the gate, not an opt-in target.
check: lint test test-e2e
    @echo "TODO: add format --check and type checking to the gate"

# Run the fast test suite (unit + integration) with coverage enforced. 95% line
# coverage is the default gate; fail below it. Lower the bar only with a
# documented reason in AGENTS.md — don't leave coverage unmeasured.
test:
    @echo "TODO: run unit/integration tests with coverage enforced (e.g. pytest --cov --cov-fail-under=95 / vitest --coverage / cargo llvm-cov --fail-under-lines 95)"

# Run end-to-end tests that exercise the built artifact the way users run it.
# Cover the primary happy path AND at least one meaningful failure/recovery
# path — not just a smoke test. If e2e genuinely does not apply (e.g. a pure
# library), delete this recipe and document why in AGENTS.md.
test-e2e:
    @echo "TODO: run e2e (e.g. playwright test / the installed CLI / a real request)"

# Lint the codebase; fail on findings.
lint:
    @echo "TODO: run linter (e.g. ruff / biome / clippy / shellcheck)"

# Format the codebase in place.
format:
    @echo "TODO: run formatter (e.g. ruff format / biome / rustfmt / shfmt)"

# Upgrade dependencies, then re-run the full gate.
upgrade:
    @echo "TODO: upgrade dependencies (e.g. uv lock --upgrade)"
    @just check

# Optional, but a common addition: a diagnostics recipe so `check` can stay
# quiet on success. Push environment/version reporting here (toolchain versions,
# tool presence, outdated deps) instead of letting it leak into the gate's
# output. Add `setup`/`setup-check` recipes too if first-run machine setup is
# more than `bootstrap`.
# doctor:
#     @echo "TODO: report toolchain + tool versions and flag anything missing"
