{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*"],
    "tooling": [
      "{workspaceRoot}/tools/validate_skill.py",
      "{workspaceRoot}/tools/smoke_skill_scripts.py"
    ],
    "dogfoodedContracts": [
      "{workspaceRoot}/oneharness.toml",
      "{workspaceRoot}/skills/bootstrap/create-repo/assets/oneharness.toml.template"
    ],
    "projectGraph": [
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/**/project.json"
    ]
  },
  "targetDefaults": {
    "validate": {
      "cache": true,
      "inputs": ["default", "tooling"]
    },
    "smoke": {
      "cache": true,
      "inputs": ["default", "tooling"]
    },
    "test": {
      "cache": true,
      "inputs": ["default"]
    }
  }
}
